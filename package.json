{
  "name": "dp-sms-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests --max-warnings=38",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run test && pnpm run typecheck && pnpm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --prod --audit-level=high"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "axios": "^1.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.25",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.26.0"
}
