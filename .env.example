# Backend API base URL. Must point to the running backend dev server.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Default tenant ID used by auth pages (e.g. forgot password) when no school
# is saved in the browser yet. After registering/creating a school, set this
# to that school's tenant ID. Leave empty for production (tenant is resolved
# from the saved school or the subdomain in the URL).
NEXT_PUBLIC_TENANT_ID=
